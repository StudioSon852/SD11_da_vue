# Copy this file to backend/.env and enter the SQL Server values from your SSMS connection.
# This example assumes SQL Server's default instance listens on TCP port 1433.
PORT=8080
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SD_11
DB_USER=sa
DB_PASSWORD=123
DB_ENCRYPT=false
DB_TRUST_CERT=true
DB_LOGIN_TIMEOUT=8

# For SQL Server Express / named instance instead of a fixed TCP port, comment out DB_SERVER/DB_PORT above
# or leave them as-is, and set this JDBC URL. SQL Browser must be running to resolve SQLEXPRESS.
# DB_JDBC_URL=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=SD_11;encrypt=false;trustServerCertificate=true;loginTimeout=8

# Use a unique random string for local development; never reuse a real production secret.
JWT_SECRET=replace_this_with_a_random_string_at_least_32_characters_long
JWT_TTL_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
AUTH_EXPOSE_RESET_TOKEN=false
